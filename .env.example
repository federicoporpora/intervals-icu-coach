# Intervals.icu API Credentials
# Retrieve your API key from Intervals.icu -> Settings -> Developer Settings -> API Access
INTERVALS_API_KEY=your_api_key_here

# Athlete ID: Default is "0" (the authenticated athlete) or your specific athlete ID (e.g., i12345)
INTERVALS_ATHLETE_ID=0

# External iCal Calendars (Optional, can also be configured in athlete_profile.json)
# PERSONAL_CALENDAR_URL=https://calendar.google.com/calendar/ical/user@gmail.com/private-xxxx/basic.ics
# UNIVERSITY_CALENDAR_URL=webcal://unibocalendar.it/get_ical?id=xxxx
