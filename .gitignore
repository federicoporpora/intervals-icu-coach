# Environment & secrets
.env
*.env.local

# Athlete local configuration & personal data (strictly local, never committed)
coach_engine/config/athlete_profile.json
coach_engine/config/athlete_memory.json
*.ics
!tests/fixtures/*.ics

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Local cache & downloads
coach_engine/data/cache/*
!coach_engine/data/cache/.gitkeep

# IDE & OS
.vscode/
.idea/
.DS_Store
*.swp
